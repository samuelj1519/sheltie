172: /// `k=v` 解析；`v` 以 `@` 开头是文件路径（**不读内容**，重放查重之后由 runtime 读）。
173: /// 返回 `(key, 值来源)`。
174: pub fn parse_input_arg(
175:     arg: &str,
176: ) -> Result<(String, sheltie_runtime::request::InputValue), String> {
177:     let (key, value) = arg
178:         .split_once('=')
179:         .ok_or_else(|| format!("--input 的值 {arg:?} 要是 k=v"))?;
180:     if key.is_empty() {
181:         return Err(format!("--input 的值 {arg:?} 缺键"));
182:     }
183:     let source = if let Some(path) = value.strip_prefix('@') {
184:         if path.is_empty() {
185:             return Err(format!("--input 的值 {arg:?} 的 @ 后要有路径"));
186:         }
187:         let abs = sheltie_runtime::request::lexical_abs(path).map_err(|error| error.to_string())?;
188:         sheltie_runtime::request::InputValue::AtFile { path: abs }
189:     } else {
190:         sheltie_runtime::request::InputValue::Literal {
191:             text: value.to_string(),
192:         }
193:     };
194:     Ok((key.to_string(), source))
195: }
