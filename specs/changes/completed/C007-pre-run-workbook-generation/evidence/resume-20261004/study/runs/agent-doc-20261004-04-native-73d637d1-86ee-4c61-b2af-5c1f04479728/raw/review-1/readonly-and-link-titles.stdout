crates/sheltie-cli/src/commands/work.rs
121: fn status(ctx: &Ctx, work: &str) -> Outcome {
122:     let svc = service(ctx);
123:     let wid = match resolve(&svc, work, None) {
124:         Ok(w) => w,
125:         Err(out) => return out,
126:     };
127:     let (text, view) = match svc.status_read(&wid) {
128:         Ok(t) => t,
129:         Err(e) => return crate::error_map::to_outcome(&e),
130:     };
131:     // next 已由 core 装配成协议形状，与 data.next 同源同形（O13）。
132:     output::ok_work_next(text, None, None, json!(view), view.card.next.clone())
133: }
134: 
135: fn result(ctx: &Ctx, work: &str) -> Outcome {
136:     let svc = service(ctx);
137:     let wid = match resolve(&svc, work, None) {
138:         Ok(work) => work,
139:         Err(out) => return out,
140:     };
141:     let (view, operations) = match svc.result(&wid) {
142:         Ok(result) => result,
143:         Err(error) => return crate::error_map::to_outcome(&error),
144:     };
145:     let next = operations
146:         .iter()
147:         .map(|operation| sheltie_core::work::render::next_item_json(&view.work_id, operation))
148:         .collect();
149:     let text = sheltie_core::work::result::render_result(&view);
150:     output::ok_work_next(text, None, None, json!(view), next)
151: }
152: 
153: /// `work stats`：runtime返回同一次装入的事实视图与next。
154: fn stats(ctx: &Ctx, work: &str) -> Outcome {
155:     let svc = service(ctx);
156:     let wid = match resolve(&svc, work, None) {
157:         Ok(w) => w,
158:         Err(out) => return out,
159:     };
160:     // stats 与 next 用同一次加载的事实视图（GF-29）；next 与状态卡同源同形。
161:     let (text, stats, ops) = match svc.stats(&wid) {
162:         Ok(t) => t,
163:         Err(e) => return crate::error_map::to_outcome(&e),
164:     };
165:     output::ok_work_next(text, None, None, json!(stats), ops)
166: }
