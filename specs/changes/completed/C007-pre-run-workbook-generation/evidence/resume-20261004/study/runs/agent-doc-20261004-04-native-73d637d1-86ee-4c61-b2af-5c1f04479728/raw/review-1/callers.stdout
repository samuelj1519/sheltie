1: //! 合法下一步。表见 `specs/architecture.md` §3.1。
2: 
3: use serde::{Deserialize, Serialize};
4: 
5: use super::state::{AttemptStatus, BlockedReason, WorkState, WorkStatus};
6: use crate::flow::{EdgeKind, Executor, Graph, Tier};
7: use crate::ids::{AttemptId, NodeId, WorkId};
8: 
9: /// 一项可执行的下一步。能直接拼成命令行（协议 §5 的 `next` 项）。
10: #[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
11: #[serde(rename_all = "snake_case", tag = "op", deny_unknown_fields)]
12: pub enum NextOp {
13:     /// `attempt begin`。进入另一节点时带 `edge`；同节点重试或首次开工时为 `None`。
14:     #[serde(rename = "attempt begin")]
15:     BeginAttempt {
16:         node: NodeId,
17:         edge: Option<EdgeKind>,
18:         executor: Executor,
19:         tier: Option<Tier>,
20:     },
21:     #[serde(rename = "attempt submit")]
22:     SubmitAttempt { attempt: AttemptId },
23:     #[serde(rename = "attempt fail")]
24:     FailAttempt { attempt: AttemptId },
25:     #[serde(rename = "attempt replace")]
26:     ReplaceAttempt { attempt: AttemptId },
27:     #[serde(rename = "gate approve")]
28:     ApproveGate { node: NodeId },
29:     #[serde(rename = "work cancel")]
30:     Cancel,
31: }
32: 
33: impl NextOp {
34:     /// 命令行形式：
35:     /// `sheltie attempt begin <work> --node <node>`、`sheltie attempt submit <work> --attempt <id> --summary "<一句话结论>"`、
36:     /// `sheltie attempt fail <work> --attempt <id> --reason "<原因>"`、`sheltie gate approve <work> --node <node>`、
37:     /// `sheltie work cancel <work>`。
38:     pub fn to_command_line(&self, work_id: &WorkId) -> String {
39:         match self {
40:             Self::BeginAttempt { node, .. } => {
41:                 format!("sheltie attempt begin {work_id} --node {node}")
42:             }
43:             Self::SubmitAttempt { attempt } => format!(
44:                 "sheltie attempt submit {work_id} --attempt {attempt} --summary \"<一句话结论>\""
45:             ),
46:             Self::FailAttempt { attempt } => {
47:                 format!("sheltie attempt fail {work_id} --attempt {attempt} --reason \"<原因>\"")
48:             }
49:             Self::ReplaceAttempt { attempt } => {
50:                 format!("sheltie attempt replace {work_id} --attempt {attempt} --reason \"<原因>\"")
51:             }
52:             Self::ApproveGate { node } => format!("sheltie gate approve {work_id} --node {node}"),
53:             Self::Cancel => format!("sheltie work cancel {work_id}"),
54:         }
55:     }
56: 
57:     /// 这项是不是「进入或重试节点 `node`」。
58:     pub fn is_begin_of(&self, node: &NodeId) -> bool {
59:         matches!(self, Self::BeginAttempt { node: n, .. } if n == node)
60:     }
61: }
62: 
63: /// 计算当前合法下一步。
64: ///
65: /// 按 `state.status` 与当前 Occurrence 的最新 Attempt 分支：
66: /// - 终态：空。
67: /// - `Blocked(Gate)`：`gate approve <current>`、`work cancel`。
68: /// - `Blocked(RetriesExhausted | NoLegalEdge)`：`work cancel`。
69: /// - 当前 Occurrence 无 Attempt，或最新 `Failed` 且真实失败数未超过 `max_retries`：`attempt begin <current>`（`edge = None`）、`work cancel`。
70: /// - 最新 `Running`：`attempt submit`、`attempt fail`、`work cancel`；本 Occurrence 尚未替换时另列 `attempt replace`。
71: /// - 最新 `Succeeded`（无门槛或已批准）：每条出边 `current -> to` 且 `visits[to] < max_visits[to]`
72: ///   给一项 `attempt begin <to>` 带 `edge`；再加 `work cancel`。
73: ///
74: /// T06 填「终态」与「无 Attempt」；T07 填「Succeeded」与「Failed 可重试」；T08 填「Running」与「Blocked」。
75: pub fn legal_next(state: &WorkState, graph: &Graph) -> Vec<NextOp> {
76:     match state.status {
77:         WorkStatus::Active => match state.latest_attempt_of_current() {
78:             // 首次到达本 Occurrence：进入或重试都从 begin 当前节点开始，不带边。
79:             None => {
80:                 let mut ops = Vec::with_capacity(2);
81:                 if let Some(def) = graph.node(&state.current.node) {
82:                     ops.push(NextOp::BeginAttempt {
83:                         node: state.current.node.clone(),
84:                         edge: None,
85:                         executor: def.executor,
86:                         tier: def.tier,
87:                     });
88:                 }
89:                 ops.push(NextOp::Cancel);
90:                 ops
91:             }
92:             Some(attempt) => match attempt.status {
93:                 AttemptStatus::Running => {
94:                     let mut ops = vec![
95:                         NextOp::SubmitAttempt {
96:                             attempt: attempt.id.clone(),
97:                         },
98:                         NextOp::FailAttempt {
99:                             attempt: attempt.id.clone(),
100:                         },
101:                     ];
102:                     if !state.has_replacement_of(&state.current) {
103:                         ops.push(NextOp::ReplaceAttempt {
104:                             attempt: attempt.id.clone(),
105:                         });
106:                     }
107:                     ops.push(NextOp::Cancel);
108:                     ops
109:                 }
110:                 AttemptStatus::Failed => {
111:                     // 还能重试就再 begin 当前节点（不带边）；否则只剩取消。
112:                     let mut ops = Vec::with_capacity(2);
113:                     if let Some(def) = graph.node(&state.current.node) {
114:                         if state.failed_count_of(&state.current) <= def.max_retries as usize {
115:                             ops.push(NextOp::BeginAttempt {
116:                                 node: state.current.node.clone(),
117:                                 edge: None,
118:                                 executor: def.executor,
119:                                 tier: def.tier,
120:                             });
121:                         }
122:                     }
123:                     ops.push(NextOp::Cancel);
124:                     ops
125:                 }
126:                 AttemptStatus::Succeeded => {
127:                     // 每条出边目标未达 max_visits 就是一项 begin；再加取消。
128:                     let mut ops = Vec::with_capacity(4);
129:                     for edge in graph.out_edges(&state.current.node) {
130:                         let Some(def) = graph.node(&edge.to) else {
131:                             continue;
132:                         };
133:                         if state.visits_of(&edge.to) < def.max_visits {
134:                             ops.push(NextOp::BeginAttempt {
135:                                 node: edge.to.clone(),
136:                                 edge: Some(edge.kind),
137:                                 executor: def.executor,
138:                                 tier: def.tier,
139:                             });
140:                         }
141:                     }
142:                     ops.push(NextOp::Cancel);
143:                     ops
144:                 }
145:                 AttemptStatus::Superseded => vec![NextOp::Cancel],
146:             },
147:         },
148:         WorkStatus::Blocked(reason) => {
149:             let mut ops = Vec::with_capacity(2);
150:             if reason == BlockedReason::Gate {
151:                 ops.push(NextOp::ApproveGate {
152:                     node: state.current.node.clone(),
153:                 });
154:             }
155:             ops.push(NextOp::Cancel);
156:             ops
157:         }
158:         WorkStatus::Succeeded | WorkStatus::Cancelled => Vec::new(),
159:     }
160: }
