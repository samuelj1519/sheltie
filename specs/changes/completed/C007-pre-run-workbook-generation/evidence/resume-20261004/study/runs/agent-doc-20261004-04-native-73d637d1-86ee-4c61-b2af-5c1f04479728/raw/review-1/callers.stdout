303: pub fn replacement_input_paths_for(
304:     state: &WorkState,
305:     graph: &Graph,
306:     attempt: &AttemptId,
307: ) -> Result<BTreeMap<String, Option<AbsPath>>> {
308:     guard_not_terminal(state)?;
309:     let record = state
310:         .attempt(attempt)
311:         .ok_or_else(|| Error::AttemptNotFound {
312:             attempt: attempt.clone(),
313:         })?;
314:     if record.status != AttemptStatus::Running {
315:         return Err(Error::AttemptNotRunning {
316:             attempt: attempt.clone(),
317:         });
318:     }
319:     if state.status != WorkStatus::Active
320:         || state.latest_attempt_of_current().map(|record| &record.id) != Some(attempt)
321:     {
322:         return Err(Error::IllegalNext {
323:             requested: format!("attempt replace {attempt}"),
324:             next: legal_next(state, graph)
325:                 .iter()
326:                 .map(|operation| operation.to_command_line(&state.work_id))
327:                 .collect(),
328:         });
329:     }
330:     if state.has_replacement_of(&state.current) {
331:         return Err(Error::ReplacementsExhausted {
332:             attempt: attempt.clone(),
333:         });
334:     }
335:     let node = graph
336:         .node(&attempt.node)
337:         .ok_or_else(|| Error::InvalidRequest {
338:             reason: format!("节点 {} 不在图里", attempt.node),
339:         })?;
340:     if record.inputs.len() != node.inputs().len() {
341:         return Err(Error::InvalidRequest {
342:             reason: "原 Attempt 的输入键集合与声明不一致".to_string(),
343:         });
344:     }
345:     node.inputs()
346:         .iter()
347:         .map(|declaration| {
348:             let reference =
349:                 record
350:                     .inputs
351:                     .get(declaration.name())
352:                     .ok_or_else(|| Error::InvalidRequest {
353:                         reason: format!("原 Attempt 缺少输入 {}", declaration.name()),
354:                     })?;
355:             let path = if matches!(declaration.source(), InputSource::EngineStats) {
356:                 None
357:             } else {
358:                 reference.as_ref().map(|reference| reference.path.clone())
359:             };
360:             Ok((declaration.name().to_string(), path))
361:         })
362:         .collect()
363: }
364: 
365: fn decide_replace(
366:     state: &WorkState,
367:     graph: &Graph,
368:     attempt: &AttemptId,
369:     reason: &str,
370:     observed_inputs: &BTreeMap<String, Option<ObservedFile>>,
371:     instruction_text: &str,
372:     ctx: &Context,
373: ) -> Result<Decision> {
374:     let paths = replacement_input_paths_for(state, graph, attempt)?;
375:     let reason = Summary::new(reason, "reason").map_err(|_| Error::SummaryTooLong {
376:         max: Summary::max_bytes(),
377:         actual: reason.len(),
378:     })?;
379:     if paths.keys().ne(observed_inputs.keys()) {
380:         return Err(Error::InvalidRequest {
381:             reason: "替换的输入观察键集合与原声明不一致".to_string(),
382:         });
383:     }
384:     let old = state
385:         .attempt(attempt)
386:         .ok_or_else(|| Error::AttemptNotFound {
387:             attempt: attempt.clone(),
388:         })?;
389:     let node = graph
390:         .node(&attempt.node)
391:         .ok_or_else(|| Error::InvalidRequest {
392:             reason: format!("节点 {} 不在图里", attempt.node),
393:         })?;
394:     let number = next_attempt_number(Some(old))?;
395:     let new_id = AttemptId::new(attempt.node.clone(), attempt.occurrence, number);
396:     for declaration in node.inputs() {
397:         let observed = observed_inputs
398:             .get(declaration.name())
399:             .and_then(Option::as_ref);
400:         if matches!(declaration.source(), InputSource::EngineStats) {
401:             if observed.is_some() {
402:                 return Err(Error::InvalidRequest {
403:                     reason: "替换不能提交 engine.stats 文件观察".to_string(),
404:                 });
405:             }
406:         } else {
407:             match old.inputs.get(declaration.name()).and_then(Option::as_ref) {
408:                 Some(reference) => {
409:                     if !observed.is_some_and(|file| {
410:                         file.path == reference.path
411:                             && file.sha256 == reference.sha256
412:                             && file.bytes == reference.bytes
413:                     }) {
414:                         return Err(Error::ArtifactModified {
415:                             input: declaration.name().to_string(),
416:                             path: reference.path.to_string(),
417:                         });
418:                     }
419:                 }
420:                 None if observed.is_none() => {}
421:                 None => {
422:                     return Err(Error::InvalidRequest {
423:                         reason: format!("未绑定输入 {} 不能在替换时重新绑定", declaration.name()),
424:                     });
425:                 }
