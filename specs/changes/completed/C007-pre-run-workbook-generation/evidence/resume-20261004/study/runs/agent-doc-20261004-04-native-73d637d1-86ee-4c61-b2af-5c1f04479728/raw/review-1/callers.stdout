444:     pub fn replace(
445:         &self,
446:         work: &WorkId,
447:         attempt: &AttemptId,
448:         reason: &InputValue,
449:         request_id: Option<String>,
450:     ) -> Result<Response> {
451:         let request_id = request_id.unwrap_or_else(|| uuid::Uuid::now_v7().to_string());
452:         let intent = RequestIntent::ReplaceAttempt {
453:             work: work.clone(),
454:             attempt: attempt.clone(),
455:             reason: reason.clone(),
456:         };
457:         self.run_command(work, &intent, request_id, &|loaded, lock| {
458:             let paths = sheltie_core::work::replacement_input_paths_for(
459:                 &loaded.state,
460:                 &loaded.graph,
461:                 attempt,
462:             )?;
463:             let reason = materialize_summary(reason)?;
464:             sheltie_core::text::Summary::new(&reason, "reason").map_err(|_| {
465:                 Error::Core(sheltie_core::Error::SummaryTooLong {
466:                     max: sheltie_core::text::Summary::max_bytes(),
467:                     actual: reason.len(),
468:                 })
469:             })?;
470:             let mut observed_inputs = BTreeMap::new();
471:             for (name, path) in paths {
472:                 let observed = match path {
473:                     Some(path) => {
474:                         let file = crate::fsx::open_managed_optional(&self.home, &path)?;
475:                         file.map(|file| {
476:                             crate::failpoint::rendezvous("replace_after_input_open", path.as_str())
477:                                 .map_err(|error| Error::io(path.as_str(), error))?;
478:                             let (sha256, bytes) =
479:                                 file.sha256_bounded(crate::fsx::MAX_FILE_BYTES)?;
480:                             crate::fsx::verify_managed_file_bound(&self.home, lock, &path, &file)?;
481:                             Ok::<_, Error>(ObservedFile::new(path, sha256, bytes))
482:                         })
483:                         .transpose()?
484:                     }
485:                     None => None,
486:                 };
487:                 observed_inputs.insert(name, observed);
488:             }
489:             Ok(PreparedCommand::plain(Command::ReplaceAttempt {
490:                 attempt: attempt.clone(),
491:                 reason,
492:                 observed_inputs,
493:                 instruction_text: instruction_text_of(loaded, &attempt.node)?,
494:             }))
495:         })
496:     }
