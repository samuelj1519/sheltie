20: /// 对一个 Work 应用一个命令。
21: ///
22: /// `state` 为 `None` 只在 `Command::Start` 时合法。其他命令先过 `guard_not_terminal`，
23: /// 再分派到对应的私有函数。返回的 `Decision.state` 是完整的新状态。
24: pub fn decide(
25:     state: Option<&WorkState>,
26:     graph: &Graph,
27:     cmd: &Command,
28:     ctx: &Context,
29: ) -> Result<Decision> {
30:     match (state, cmd) {
31:         (None, Command::Start { .. }) => decide_start(graph, cmd, ctx),
32:         (None, other) => Err(Error::InvalidRequest {
33:             reason: format!("{} 要求 Work 已存在", other.name()),
34:         }),
35:         (Some(_), Command::Start { .. }) => Err(Error::InvalidRequest {
36:             reason: "Work 已存在，不能再 start".to_string(),
37:         }),
38:         (Some(state), cmd) => {
39:             guard_not_terminal(state)?;
40:             match cmd {
41:                 Command::Start { .. } => unreachable!("上面已处理"),
42:                 Command::BeginAttempt {
43:                     node,
44:                     observed_inputs,
45:                     instruction_text,
46:                 } => decide_begin(state, graph, node, observed_inputs, instruction_text, ctx),
47:                 Command::SubmitAttempt {
48:                     attempt,
49:                     summary,
50:                     observed_outputs,
51:                 } => decide_submit(state, graph, attempt, summary, observed_outputs, ctx),
52:                 Command::FailAttempt { attempt, reason } => {
53:                     decide_fail(state, graph, attempt, reason, ctx)
54:                 }
55:                 Command::ReplaceAttempt {
56:                     attempt,
57:                     reason,
58:                     observed_inputs,
59:                     instruction_text,
60:                 } => decide_replace(
61:                     state,
62:                     graph,
63:                     attempt,
64:                     reason,
65:                     observed_inputs,
66:                     instruction_text,
67:                     ctx,
68:                 ),
69:                 Command::ApproveGate { node } => decide_approve(state, graph, node, ctx),
70:                 Command::Cancel => decide_cancel(state, ctx),
71:             }
72:         }
73:     }
74: }
75: 
76: /// 终态 Work 拒绝一切命令：`Error::WorkTerminal`。
77: fn guard_not_terminal(state: &WorkState) -> Result<()> {
78:     if state.status.is_terminal() {
79:         return Err(Error::WorkTerminal {
80:             status: state.status.to_string(),
81:         });
82:     }
83:     Ok(())
84: }
85: 
86: fn increment_blocked_count(state: &mut WorkState) -> Result<()> {
87:     state.blocked_count =
88:         state
89:             .blocked_count
90:             .checked_add(1)
91:             .ok_or_else(|| Error::InvalidRequest {
92:                 reason: "累计受阻次数超出可表示范围".to_string(),
93:             })?;
94:     Ok(())
95: }
