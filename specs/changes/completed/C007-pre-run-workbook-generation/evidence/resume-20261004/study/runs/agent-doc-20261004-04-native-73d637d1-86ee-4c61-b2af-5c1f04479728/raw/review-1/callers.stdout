610: /// 1. Attempt 必须 `Running`，否则 `Error::AttemptNotRunning`。
611: /// 2. `summary` ≤ 4096 字节，否则 `Error::SummaryTooLong`。
612: /// 3. `check_outputs`。任一失败整体 `Err`，状态不变。
613: /// 4. 记录输出 `ArtifactRef`，`status = Succeeded`，`ended_at = ctx.now`。
614: /// 5. `status_after_success` 定 Work 状态（含 `gate`）。
615: /// 6. 回复 `Reply::AttemptSubmitted`；效果 `SealOutputs`、`RefreshStatusCard`。
616: fn decide_submit(
617:     state: &WorkState,
618:     graph: &Graph,
619:     attempt: &AttemptId,
620:     summary: &str,
621:     observed_outputs: &BTreeMap<String, Option<ObservedFile>>,
622:     ctx: &Context,
623: ) -> Result<Decision> {
624:     let not_running = || Error::AttemptNotRunning {
625:         attempt: attempt.clone(),
626:     };
627:     let prev = state.attempt(attempt).ok_or_else(not_running)?;
628:     if prev.status != AttemptStatus::Running {
629:         return Err(not_running());
630:     }
631:     // 协议 attempt submit 第 2 步：超限报 `SUMMARY_TOO_LONG`，不是通用的 `TEXT_TOO_LONG`。
632:     let summary_text = Summary::new(summary, "summary").map_err(|_| Error::SummaryTooLong {
633:         max: Summary::max_bytes(),
634:         actual: summary.len(),
635:     })?;
636:     let sealed = check_outputs(state, graph, attempt, observed_outputs)?;
637: 
638:     let mut new_state = state.clone();
639:     if let Some(a) = new_state.attempt_mut(attempt) {
640:         a.status = AttemptStatus::Succeeded;
641:         a.outputs = sealed.clone();
642:         a.summary = Some(summary_text);
643:         a.ended_at = Some(ctx.now.clone());
644:     }
645:     new_state.status = status_after_success(&new_state, graph, true);
646:     // 累计受阻在发生时记录（GF-29）：gate 阻断与 no_legal_edge 各计一次。
647:     if matches!(
648:         new_state.status,
649:         WorkStatus::Blocked(BlockedReason::Gate | BlockedReason::NoLegalEdge)
650:     ) {
651:         increment_blocked_count(&mut new_state)?;
652:     }
653:     new_state.updated_at = ctx.now.clone();
654: 
655:     Ok(Decision {
656:         state: new_state,
657:         effects: vec![
658:             Effect::SealOutputs {
659:                 paths: sealed.values().map(|r| r.path.clone()).collect(),
660:             },
661:             Effect::RefreshStatusCard,
