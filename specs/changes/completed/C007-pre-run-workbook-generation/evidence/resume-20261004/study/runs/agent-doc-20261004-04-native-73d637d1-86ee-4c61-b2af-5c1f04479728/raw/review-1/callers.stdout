1: //! `attempt begin | submit | fail | replace`。
2: 
3: use sheltie_core::ids::{AttemptId, NodeId};
4: use sheltie_core::work::Reply;
5: 
6: use crate::cli::AttemptCmd;
7: use crate::commands::Ctx;
8: use crate::commands::work::{next_lines, reply_mismatch, resolve, service};
9: use crate::output::{self, Outcome};
10: 
11: /// `--summary` 与 `--reason` 经 `cli::parse_text_arg`；`--attempt` 经 `AttemptId::parse`。
12: /// `begin` 已随 T18 一并实现（`work cancel` 的测试要走它验证 `WORK_TERMINAL`，见 plan.md T18 任务卡）；
13: /// `submit` 与 `fail` 归 T19。
14: pub fn run(ctx: &Ctx, cmd: AttemptCmd) -> Outcome {
15:     match cmd {
16:         AttemptCmd::Begin { work, node } => begin(ctx, &work, &node),
17:         AttemptCmd::Submit {
18:             work,
19:             attempt,
20:             summary,
21:         } => submit(ctx, &work, &attempt, &summary),
22:         AttemptCmd::Fail {
23:             work,
24:             attempt,
25:             reason,
26:         } => fail(ctx, &work, &attempt, &reason),
27:         AttemptCmd::Replace {
28:             work,
29:             attempt,
30:             reason,
31:         } => replace(ctx, &work, &attempt, &reason),
32:     }
33: }
34: 
35: /// `attempt begin`（协议 §3 第 5 步的返回）。
36: fn begin(ctx: &Ctx, work: &str, node: &str) -> Outcome {
37:     let node = match NodeId::new(node) {
38:         Ok(n) => n,
39:         Err(e) => return crate::error_map::to_outcome(&sheltie_runtime::Error::Core(e)),
40:     };
41:     let svc = service(ctx);
42:     let wid = match resolve(&svc, work, ctx.request_id.as_deref()) {
43:         Ok(w) => w,
44:         Err(out) => return out,
45:     };
46:     let resp = match svc.begin(&wid, &node, ctx.request_id.clone()) {
47:         Ok(r) => r,
48:         Err(e) => return crate::error_map::to_outcome(&e),
49:     };
50:     // 数据来自提交时快照（cli-result/v4），不回读 Store（O04）。
51:     let (attempt, brief_path, output_dir) = match &resp.reply {
52:         Reply::AttemptBegun {
53:             attempt,
54:             brief_path,
55:             output_dir,
56:             ..
57:         } => (attempt.clone(), brief_path.clone(), output_dir.clone()),
58:         other => return reply_mismatch("AttemptBegun", other),
59:     };
60:     let text = next_lines(
61:         format!("已开始 {attempt}\n任务书：{brief_path}\n输出目录：{output_dir}\n"),
62:         &resp,
63:         &wid,
64:     );
65:     output::ok_response(text, resp, &wid)
66: }
67: 
68: /// `attempt submit`（协议 §3 第 6 步的返回）。
69: fn submit(ctx: &Ctx, work: &str, attempt: &str, summary: &str) -> Outcome {
70:     let summary = match crate::cli::parse_text_arg(summary) {
71:         Ok(s) => s,
72:         Err(m) => return output::param_error(m),
73:     };
74:     let attempt = match AttemptId::parse(attempt) {
75:         Ok(a) => a,
76:         Err(e) => return crate::error_map::to_outcome(&sheltie_runtime::Error::Core(e)),
77:     };
78:     let svc = service(ctx);
79:     let wid = match resolve(&svc, work, ctx.request_id.as_deref()) {
80:         Ok(w) => w,
81:         Err(out) => return out,
82:     };
83:     let resp = match svc.submit(&wid, &attempt, &summary, ctx.request_id.clone()) {
84:         Ok(r) => r,
85:         Err(e) => return crate::error_map::to_outcome(&e),
86:     };
87:     let (attempt, outputs) = match &resp.reply {
88:         Reply::AttemptSubmitted { attempt, outputs } => (attempt.clone(), outputs.clone()),
89:         other => return reply_mismatch("AttemptSubmitted", other),
90:     };
91:     let mut text = format!("已提交 {attempt}\n");
92:     for (name, r) in &outputs {
93:         text.push_str(&format!(
94:             "  {name} → {} (sha256 {})\n",
95:             r.path,
96:             r.sha256.as_str()
97:         ));
98:     }
99:     let text = next_lines(text, &resp, &wid);
100:     output::ok_response(text, resp, &wid)
101: }
102: 
103: /// `attempt fail`。
104: fn fail(ctx: &Ctx, work: &str, attempt: &str, reason: &str) -> Outcome {
105:     let reason = match crate::cli::parse_text_arg(reason) {
106:         Ok(s) => s,
107:         Err(m) => return output::param_error(m),
108:     };
109:     let attempt = match AttemptId::parse(attempt) {
110:         Ok(a) => a,
111:         Err(e) => return crate::error_map::to_outcome(&sheltie_runtime::Error::Core(e)),
112:     };
113:     let svc = service(ctx);
114:     let wid = match resolve(&svc, work, ctx.request_id.as_deref()) {
115:         Ok(w) => w,
116:         Err(out) => return out,
117:     };
118:     let resp = match svc.fail(&wid, &attempt, &reason, ctx.request_id.clone()) {
119:         Ok(r) => r,
120:         Err(e) => return crate::error_map::to_outcome(&e),
121:     };
122:     let attempt = match &resp.reply {
123:         Reply::AttemptFailed { attempt } => attempt.clone(),
124:         other => return reply_mismatch("AttemptFailed", other),
125:     };
126:     let text = next_lines(format!("已标记 {attempt} 失败\n"), &resp, &wid);
127:     output::ok_response(text, resp, &wid)
128: }
129: 
130: fn replace(ctx: &Ctx, work: &str, attempt: &str, reason: &str) -> Outcome {
131:     let reason = match crate::cli::parse_text_arg(reason) {
132:         Ok(value) => value,
133:         Err(message) => return output::param_error(message),
134:     };
135:     let attempt = match AttemptId::parse(attempt) {
136:         Ok(value) => value,
137:         Err(error) => return crate::error_map::to_outcome(&sheltie_runtime::Error::Core(error)),
138:     };
139:     let svc = service(ctx);
140:     let wid = match resolve(&svc, work, ctx.request_id.as_deref()) {
141:         Ok(value) => value,
142:         Err(outcome) => return outcome,
143:     };
144:     let resp = match svc.replace(&wid, &attempt, &reason, ctx.request_id.clone()) {
145:         Ok(value) => value,
146:         Err(error) => return crate::error_map::to_outcome(&error),
147:     };
148:     let Reply::AttemptReplaced {
149:         replaced_attempt,
150:         attempt,
151:         brief_path,
152:         output_dir,
153:         ..
154:     } = &resp.reply
155:     else {
156:         return reply_mismatch("AttemptReplaced", &resp.reply);
157:     };
158:     let text = next_lines(
159:         format!(
160:             "已替换 {replaced_attempt}，新尝试：{attempt}\n任务书：{brief_path}\n输出目录：{output_dir}\n"
161:         ),
162:         &resp,
163:         &wid,
164:     );
165:     output::ok_response(text, resp, &wid)
166: }
