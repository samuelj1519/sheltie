1: //! 状态机的唯一入口 `decide`，以及每个命令一个私有函数。
2: //! 细则按 `specs/contracts/protocol.md` §3 逐条对应。
3: 
4: use std::collections::BTreeMap;
5: 
6: use super::command::{Command, Context, Decision, Effect, ObservedFile, Reply};
7: use super::next::legal_next;
8: use super::render::{render_brief, render_stats_json};
9: use super::start::validate_start_inputs;
10: use super::state::{
11:     Approval, ArtifactRef, Attempt, AttemptStatus, BlockedReason, Occurrence, WorkState, WorkStatus,
12: };
13: use crate::digest::Sha256Hex;
14: use crate::error::{Error, Result};
15: use crate::flow::{Graph, InputSource};
16: use crate::ids::{AttemptId, NodeId};
17: use crate::path::AbsPath;
