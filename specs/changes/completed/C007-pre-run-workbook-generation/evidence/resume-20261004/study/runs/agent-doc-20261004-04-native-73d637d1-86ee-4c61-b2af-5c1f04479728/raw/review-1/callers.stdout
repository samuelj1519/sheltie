828:         a.status = AttemptStatus::Failed;
829:         a.fail_reason = Some(reason_text);
830:         a.ended_at = Some(ctx.now.clone());
831:     }
832:     new_state.status =
833:         status_after_failure(new_state.failed_count_of(&prev.occurrence()), max_retries);
