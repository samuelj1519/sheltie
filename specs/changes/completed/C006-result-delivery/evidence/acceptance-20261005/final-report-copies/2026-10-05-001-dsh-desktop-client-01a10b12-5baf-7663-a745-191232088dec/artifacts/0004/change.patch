+<!doctype html>
+<html lang="zh-CN">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'">
+  <title>连接 dsh</title>
+  <link rel="stylesheet" href="style.css">
+</head>
+<body>
+  <main>
+    <header><h1>连接 dsh</h1><p>使用已有服务，或由客户端启动本机后端。</p></header>
+    <div class="tabs" role="tablist" aria-label="连接方式">
+      <button id="external-tab" type="button" role="tab" aria-selected="true" aria-controls="external-panel" tabindex="0">现有服务</button>
+      <button id="owned-tab" type="button" role="tab" aria-selected="false" aria-controls="owned-panel" tabindex="-1">客户端启动</button>
+    </div>
+    <form id="connection-form">
+      <section id="external-panel" role="tabpanel" aria-labelledby="external-tab">
+        <div class="field"><label for="endpoint">服务地址</label><input id="endpoint" type="url" spellcheck="false" placeholder="http://127.0.0.1:3080" autocomplete="off"></div>
+        <p class="help">连接本机已运行的 dsh。退出客户端时，服务继续运行。</p>
+      </section>
+      <section id="owned-panel" role="tabpanel" aria-labelledby="owned-tab" hidden>
+        <div class="field"><label for="nodePath">Node</label><input id="nodePath" type="text" spellcheck="false" autocomplete="off"><button type="button" data-choose="nodePath" aria-label="选择 Node 程序">选择</button></div>
+        <div class="field"><label for="launcherPath">dsh CLI</label><input id="launcherPath" type="text" spellcheck="false" autocomplete="off"><button type="button" data-choose="launcherPath" aria-label="选择 dsh CLI 文件">选择</button></div>
+        <p class="help">CLI 请选择已安装 dsh 的 JavaScript 入口文件，如 <code>lib/bin.js</code>。</p>
+        <div class="field"><label for="homePath">dsh Home</label><input id="homePath" type="text" spellcheck="false" autocomplete="off"><button type="button" data-choose="homePath" aria-label="选择 dsh Home">选择</button></div>
+        <p class="help">默认使用客户端自己的持久目录。要使用已有模型配置和会话，可明确选择对应的 dsh Home。</p>
+        <div class="field"><label for="cwd">工作目录</label><input id="cwd" type="text" spellcheck="false" autocomplete="off"><button type="button" data-choose="cwd" aria-label="选择工作目录">选择</button></div>
+        <p class="help">启动后分配空闲端口。退出客户端时，会等待所启动的后端停止；数据目录保留。</p>
+      </section>
+      <p id="config-error" class="error" role="alert" hidden></p>
+      <div class="actions"><button id="connect" class="primary" type="submit">连接</button><button id="stop" type="button" hidden>断开连接</button></div>
+    </form>
+    <section class="connection-status" aria-label="连接状态">
+      <p id="status" role="status" aria-live="polite">正在读取连接设置…</p>
+      <p id="connected-url" class="help" hidden></p>
+      <p id="action-error" class="error" role="alert" hidden></p>
+      <details id="diagnostic-details" hidden><summary>查看后端诊断</summary><pre id="diagnostics"></pre></details>
+    </section>
+  </main>
+  <script type="module" src="../lib/renderer.js"></script>
+</body>
+</html>
diff --git a/ui/style.css b/ui/style.css
new file mode 100644
index 0000000000000000000000000000000000000000..7b0b2b7d9382f4e9b2f0fb9c862b8580bb4421f6
--- /dev/null
+++ b/ui/style.css
@@ -0,0 +1,31 @@
+:root { color-scheme: light; font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", "Noto Sans", sans-serif; color: #1f2a44; background: #f7f9fc; font-size: 14px; line-height: 1.5; }
+* { box-sizing: border-box; }
+body { margin: 0; }
+main { max-width: 700px; margin: 0 auto; padding: 28px 30px 24px; }
+header { margin-bottom: 22px; }
+h1 { margin: 0 0 5px; font-size: 24px; font-weight: 650; letter-spacing: -.35px; }
+p { margin: 0; }
+header p { color: #1f2a44; opacity: .75; }
+.tabs { display: flex; border-bottom: 1px solid #dbe3ef; gap: 24px; margin-bottom: 24px; }
+button { font: inherit; color: inherit; padding: 7px 13px; border: 1px solid #dbe3ef; border-radius: 5px; background: #fff; cursor: pointer; white-space: nowrap; }
+.tabs button { border: 0; border-bottom: 2px solid transparent; border-radius: 0; padding: 9px 1px; background: transparent; }
+.tabs button[aria-selected="true"] { border-bottom-color: #4d6bfe; color: #1f2a44; font-weight: 600; }
+.field { display: grid; grid-template-columns: 82px minmax(0, 1fr) auto; align-items: center; gap: 10px; margin-top: 15px; }
+.field:first-child { margin-top: 0; }
+#external-panel .field { grid-template-columns: 82px minmax(0, 1fr); }
+input { min-width: 0; width: 100%; padding: 8px 9px; font: inherit; border: 1px solid #dbe3ef; border-radius: 5px; color: #1f2a44; background: #fff; }
+.help { margin-top: 8px; font-size: 12px; line-height: 1.6; color: #1f2a44; opacity: .75; overflow-wrap: anywhere; }
+.field + .help { margin-left: 92px; }
+.actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
+.primary { color: #fff; background: #1f2a44; border-color: #1f2a44; min-width: 88px; font-weight: 600; }
+button:hover:enabled { border-color: #4d6bfe; }
+button:disabled, input:disabled { opacity: .6; cursor: default; }
+button:focus-visible, input:focus-visible, summary:focus-visible { outline: 3px solid #4d6bfe; outline-offset: 3px; }
+.connection-status { border-top: 1px solid #dbe3ef; margin-top: 26px; padding-top: 17px; }
+#status { font-weight: 600; }
+.error { color: #b54708; font-size: 13px; overflow-wrap: anywhere; margin-top: 12px; }
+details { margin-top: 13px; font-size: 12px; }
+summary { cursor: pointer; color: #1f2a44; opacity: .75; width: fit-content; }
+pre { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 180px; overflow: auto; background: #fff; border: 1px solid #dbe3ef; padding: 12px; border-radius: 4px; font-size: 11px; }
+[hidden] { display: none !important; }
+@media (max-width: 480px) { main { padding: 22px 18px; } .field { grid-template-columns: 68px minmax(0, 1fr) auto; gap: 8px; } #external-panel .field { grid-template-columns: 68px minmax(0, 1fr); } .field + .help { margin-left: 76px; } }
