229: #[cfg(test)]
230: mod tests {
231:     use super::*;
232: 
233:     // Task: C002-T24
234:     #[test]
235:     fn input_file_arguments_are_lexical_and_do_not_probe_the_filesystem() {
236:         let missing = "/this/path/does/not/exist/sheltie-input";
237:         let (key, input) = parse_input_arg(&format!("topic=@{missing}")).unwrap();
238:         assert_eq!(key, "topic");
239:         assert_eq!(
240:             input,
241:             sheltie_runtime::request::InputValue::AtFile {
242:                 path: missing.to_string()
243:             }
244:         );
245:         assert_eq!(
246:             parse_text_arg(&format!("@{missing}")).unwrap(),
247:             sheltie_runtime::request::InputValue::AtFile {
248:                 path: missing.to_string()
249:             }
250:         );
251:     }
252: }
