+/// 失败后的状态只依赖本次重试序号与冻结的重试上限。
+fn status_after_failure(retry: u32, max_retries: u32) -> WorkStatus {
+    if retry >= max_retries {
+        WorkStatus::Blocked(BlockedReason::RetriesExhausted)
+    } else {
+        WorkStatus::Active
+    }
+}
